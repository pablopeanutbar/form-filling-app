# API Base URL (empty uses Vite proxy to /api)
VITE_API_URL=

# Optional official listing. Leave empty until formER has a Chrome Web Store listing.
VITE_CHROME_WEB_STORE_URL=

# Development server only: local path serving the explicitly built, verified ZIP.
# Never put the ZIP in client/public. Restart Vite after changing this path.
FORMER_EXTENSION_ZIP_URL=/__former-extension/formER-development.zip

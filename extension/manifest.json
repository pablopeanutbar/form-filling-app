{
  "manifest_version": 3,
  "name": "formER — Intelligent Form Autofill",
  "version": "0.2.0",
  "description": "AI/ML-powered intelligent form field detection and autofill assistance.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "formER - Review form",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/review.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/review.html"
  }
}

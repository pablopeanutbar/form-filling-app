{
  "manifest_version": 3,
  "name": "formER — Intelligent Form Autofill",
  "version": "0.2.0",
  "description": "AI/ML-powered intelligent form field detection and autofill assistance.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": ["http://localhost/*"],
  "minimum_chrome_version": "102",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "formER Field Detector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

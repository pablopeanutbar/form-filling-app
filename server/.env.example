# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection String or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/former?retryWrites=true&w=majority

# Session Security Configuration
# SESSION_SECRET must be at least 32 characters in production
SESSION_SECRET=a_very_secure_secret_key_with_at_least_32_characters_long
SESSION_MAX_AGE_MS=604800000

# CORS Configuration (Comma-separated list of explicitly allowed origins)
ALLOWED_ORIGINS=http://localhost:5173

# Production only (NODE_ENV=production): exact published Chrome Web Store IDs.
# Leave empty until a real listing ID is known; empty disables extension clients.
# Development IDs are NEVER included in this list automatically.
EXTENSION_IDS=

# Development/test only: configure the stable development extension ID.
# The development extension ID is pinned via the public manifest "key" property in extension/manifest.json:
# egddjhnhnbgdhgiepnfmnnhfagbaambn
# All developers and testers loading the unpacked extension (or artifacts/extension/formER-development.zip)
# receive this exact ID regardless of local path.
# Comma-separated IDs are supported; no wildcards. Empty disables extension clients.
# Restart the backend after changes. Neither setting replaces pairing/credentials.
EXTENSION_DEV_IDS=egddjhnhnbgdhgiepnfmnnhfagbaambn
# Optional cloud field classification. Keep disabled until configured.
# Use a Google AI Studio key from a project without paid billing.
# The backend cannot determine the key's billing tier. No paid fallback is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MATCHING_ENABLED=false
# Enable only on a private workstation with a synthetic-only database.
# In development, enabling both flags binds the server to IPv4 loopback.
# Do not expose that server through a proxy, tunnel, or public port.
GEMINI_PRIVATE_SYNTHETIC_DEV=false
# Process-local limits: one concurrent call, 2/minute, 100/UTC day.
# Use one backend matching process until a shared quota limiter is configured.

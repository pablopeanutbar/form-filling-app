# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection String or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/former?retryWrites=true&w=majority

# Session Security Configuration
# SESSION_SECRET must be at least 32 characters in production
SESSION_SECRET=a_very_secure_secret_key_with_at_least_32_characters_long
SESSION_MAX_AGE_MS=604800000

# CORS Configuration (Comma-separated list of explicitly allowed origins)
ALLOWED_ORIGINS=http://localhost:5173
